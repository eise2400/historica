# Kopieren nach .env und Werte anpassen.

DJANGO_SECRET_KEY=bitte-geheimen-schluessel-eintragen
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Datenbank: standardmäßig SQLite. Für PostgreSQL DB_ENGINE=postgresql setzen.
DB_ENGINE=sqlite
DB_NAME=historica
DB_USER=historica
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# E-Mail-Versand (Kontaktformular). Ohne SMTP-Angaben werden Mails nur
# in der Konsole ausgegeben.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@historica-deing.de
CONTACT_RECIPIENT_EMAIL=webmaster@historica-deing.de
